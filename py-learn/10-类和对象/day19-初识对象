# 设计类
class Student:
    gender = None
    nationality = None
    native_place = None
    age = None
    name = None
# 创建对象
stu_1 = Student()
# 对象属性赋值
stu_1.name = "王俊卡"
stu_1.gender = "男"
stu_1.nationality = "CN"
stu_1.native_place = "山东省"
stu_1.age = 19

# 成员属性和成员方法
class Student:
    name = None
    def say_hi1(self):
        print(f"大家好，我是{self.name}")
    def say_hi2(self, msg):
        print(f"大家好，我是{self.name}，{msg}")

stu1 = Student()
stu1.name = "蔡徐坤"
stu1.say_hi1()

stu1 = Student()
stu1.name = "林俊节"
stu1.say_hi1()

stu2 = Student()
stu2.name = "蔡徐坤"
stu2.say_hi2("练习时长两年半")

class Clock:
    name = None
    price = None

    def ring(self):
        # import winsound
        # winsound.Beep(1000, 3000)
        import subprocess
        subprocess.run(["afplay", "/System/Library/Sounds/Ping.aiff"])

clock1 = Clock()
clock1.name = "001"
clock1.price = 9.99
print(f"闹钟编号{clock1.name}，闹钟价格{clock1.price}")
clock1.ring()

clock2 = Clock()
clock2.name = "002"
clock2.price = 99.99
print(f"闹钟的编号是{clock2.name}，闹钟的价格是{clock2.price}")