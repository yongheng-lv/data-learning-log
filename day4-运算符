"""
运算符+字符串的三种定义方式
"""

# 算术运算符
print("1+1=", 1+1)
print("2-1=", 2-1)
print("2*3=", 2*3)
print("6/2=", 6/2)  
print("6//2=", 6//2) # 取整除，返回商的整数部分
print("5%2=", 5%2)  # 取余数
print("2**2=", 2**2)  # 幂运算

# 赋值运算符
# 1.标准赋值
# = 把右边的值赋给左边的变量
num = 1 + 2 * 3
print("num =", num)
# 2.复合赋值运算符
# += （c+=a等效于c=c+a）{[-= /= %= *= //= **=]类比+=}
num = 1
num += 1
print("num =", num)

# 字符串的三种定义方式
# 1.单引号定义字符串
name = '黑马程序员'
print(type(name))
# 2.双引号定义字符串
name = "黑马程序员"
print(type(name))
# 3.三引号定义字符串
name = '''黑马程序员'''
print(type(name)) 

# 字符串引号的嵌套
# 1.单引号定义的字符串中嵌套双引号
name = '"黑马程序员"'
# 2.双引号定义的字符串中嵌套单引号
name = "'黑马程序员'"
# 3.使用转义字符\解除引号的效用
name = "\"黑马程序员"
print(name)

