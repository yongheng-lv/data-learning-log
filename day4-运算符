"""
运算符
"""

# 算术运算符
print("1+1=", 1+1)
print("2-1=", 2-1)
print("2*3=", 2*3)
print("6/2=", 6/2)  
print("6//2=", 6//2) # 取整除，返回商的整数部分
print("5%2=", 5%2)  # 取余数
print("2**2=", 2**2)  # 幂运算

#赋值运算符
# = 把右边的值赋给左边的变量
num = 1 + 2 * 3
print("num =", num)
# 复合赋值运算符
# += （c+=a等效于c=c+a）{[-= /= %= *= //= **=]类比+=}
num = 1
num += 1
print("num +=1: ", num)
